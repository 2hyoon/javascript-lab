{
  "name": "javascript-lab",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "webpack --watch --mode development",
    "dev": "webpack --watch --mode development",
    "prod": "webpack --mode production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:js": "eslint \"src/scripts/**/*.js\" \"*.js\"",
    "lint:sass": "stylelint \"src/styles/**/*.{scss,sass}\"",
    "lint": "npm run lint:js && npm run lint:sass",
    "prettier:check": "prettier --check \"src/{html,scripts,styles}/**/*.{html,scss,js,json}\" \"*.{js,json}\"",
    "prettier:write": "prettier --write \"src/{html,scripts,styles}/**/*.{html,scss,js,json}\" \"*.{js,json}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2hyoon/javascript-lab.git"
  },
  "keywords": [
    "webpack",
    "vanila",
    "javascript",
    "scss"
  ],
  "author": "Hailey Yoon",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/2hyoon/javascript-lab/issues"
  },
  "homepage": "https://github.com/2hyoon/javascript-lab#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.4.24",
    "browser-sync": "^3.0.4",
    "browser-sync-webpack-plugin": "^2.4.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.10.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "sass-loader": "^17.0.0",
    "stylelint": "^17.3.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.1.10",
    "webpack": "^5.105.2",
    "webpack-cli": "^7.2.1"
  },
  "overrides": {
    "minimatch": "^10.0.3",
    "brace-expansion": "^5.0.8"
  }
